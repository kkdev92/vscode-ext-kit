# Normalize all text files to LF in the repository and in the working tree.
# Without this, `core.autocrlf=true` on Windows checks files out as CRLF while
# Prettier is configured with `endOfLine: "lf"`, so `npm run format:check`
# fails locally after every checkout even though the committed content is fine.
* text=auto eol=lf

# Binary files git should never touch.
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.vsix binary
