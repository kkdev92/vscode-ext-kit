{
  "name": "@kkdev92/vscode-ext-kit",
  "version": "1.1.0",
  "description": "A lightweight utility library for VS Code extension development",
  "author": "kkdev92",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkdev92/vscode-ext-kit.git"
  },
  "bugs": {
    "url": "https://github.com/kkdev92/vscode-ext-kit/issues"
  },
  "homepage": "https://github.com/kkdev92/vscode-ext-kit#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./timing": {
      "types": "./dist/std/timing.d.ts",
      "import": "./dist/std/timing.js",
      "default": "./dist/std/timing.js"
    },
    "./retry": {
      "types": "./dist/std/retry.d.ts",
      "import": "./dist/std/retry.js",
      "default": "./dist/std/retry.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "MIGRATION.md",
    "LICENSE"
  ],
  "engines": {
    "vscode": "^1.96.0",
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@types/vscode": "~1.125.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "knip": "^6.29.0",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "prepare": "husky",
    "clean": "rimraf dist",
    "build": "npm run clean && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "node scripts/smoke-consumer.mjs",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json",
    "knip": "knip",
    "prepublishOnly": "npm run clean && npm run lint && npm run typecheck && npm run knip && npm run test && npm run build"
  },
  "keywords": [
    "vscode",
    "vscode-extension",
    "extension",
    "utility",
    "logger",
    "commands",
    "progress",
    "configuration",
    "tree-view",
    "webview",
    "typescript"
  ],
  "lint-staged": {
    "{src,tests}/**/*.ts": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
